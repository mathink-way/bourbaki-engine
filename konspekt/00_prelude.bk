-- Прелюдия. Глава I "Теории множеств" Бурбаки: схемы S1-S7 и теории, которые они задают.
-- Только определения, теорем здесь нет. Всё лежит в пространстве имён base:
-- S1 это схема определённой формальной теории, а не закон природы.
-- Подключается так:
--   import "00_prelude.bk"
--   open base
--
-- Сокращения ⇒, ∧, ⇔, ∃, ∀ встроены в запись (определения в src/formative.rs).
-- Например, квантор существования по определению есть $(\exists x)\,R \equiv (\tau_x(R) \mid x)\,R$:
--   A ⇒ B   есть ∨ ¬A B                     (§ 3, n° 1)
--   A ∧ B   есть ¬(¬A ∨ ¬B)                 (§ 3, n° 4)
--   A ⇔ B   есть (A ⇒ B) ∧ (B ⇒ A)          (§ 3, n° 5)
--   (∃x)R   есть (τx(R) | x) R              (§ 4, n° 1)
--   (∀x)R   есть ¬(∃x)¬R
--
-- Метапеременные (жирные буквы Бурбаки) объявляются в фигурных скобках.
-- {A : rel} это "произвольное соотношение A"; внутри это специальный знак веса 0.
-- {R : rel 1} это R{x}, соотношение с выделенной буквой; пишется R(x) или R(T).

-- Знак равенства общий для всех (запись формул одна на весь конспект).
sign = [\eq] : rel 2 infix

namespace base

-- § 3, n° 1. Логические схемы.
scheme S1 {A : rel} : (A ∨ A) ⇒ A
scheme S2 {A B : rel} : A ⇒ (A ∨ B)
scheme S3 {A B : rel} : (A ∨ B) ⇒ (B ∨ A)
scheme S4 {A B C : rel} : (A ⇒ B) ⇒ ((C ∨ A) ⇒ (C ∨ B))

-- § 4, n° 2. Схема кванторов: если R верно для T, то существует x, для которого R.
scheme S5 {R : rel 1} {T : term} : R(T) ⇒ (∃x) R(x)

-- § 5, n° 1. Равенство и эгалитарные схемы.
scheme S6 {R : rel 1} {T U : term} : T = U ⇒ (R(T) ⇔ R(U))
scheme S7 {R S : rel 1} : (∀x)(R(x) ⇔ S(x)) ⇒ τx(R(x)) = τx(S(x))

theory Logical { schemes S1 S2 S3 S4 }
theory Quantified extends Logical { schemes S5 }
theory Egalitarian extends Quantified {
  signs =
  schemes S6 S7
}

end
