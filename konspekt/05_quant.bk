-- § 4, n° 1-3. Кванторы (стр. 53-57): C26-C34.
--
-- Задача: свойства ∃ и ∀ (перестановка с ¬, ∧, ∨, друг с другом).
-- Проблема: у Бурбаки (∃x)R есть R(τx(R)), а единственная новая схема S5; рассуждения
-- книги идут в теории 𝒯₀, где x не константа.
-- Решение: R{x} это метапеременная веса 1 (пишется R(x)), "x не встречается в R" это
-- метапеременная веса 0 (R, без скобок): в знак метапеременной никакая буква не входит.
-- Условие "R ⇒ S теорема, x не константа" записывается гипотезой (∀x)(R(x) ⇒ S(x)):
-- при x не константе это одно и то же (C27 и C30).
-- Что осталось: подставлять R(x) := ... можно не писать, если R видно из строки
-- (сопоставление образцов Миллера); там, где не видно, подстановка пишется явно.

import "00_prelude.bk"
open base
import "04_equiv.bk"
import "02_quant_eq.bk"
namespace ch1
in Quantified

-- CS8: (∃x)R и (∃y)R' это одно и то же знакосочетание (связанная буква ничего не значит).
-- Поэтому C8 (A ⇒ A) подходит к такой строке буквально.
theorem CS8_example {R : rel 1} : (∃x)R(x) ⇒ (∃y)R(y) by C8

-- C26: (∀x)R это буквально ¬¬(τx(¬R)|x)R, так что это C24 для "не не".
theorem C26 {R : rel 1} : (∀x)R(x) ⇔ R(τx(¬R(x))) by C24_1

-- C27 это правило `gen` (обобщение): пример. Буква x здесь не константа.
theorem C27_example {R : rel 1} : (∀x)(R(x) ⇒ R(x)) {
  R(x) ⇒ R(x)          by C8
  (∀x)(R(x) ⇒ R(x))    by gen ^ with x
}

-- C28: ¬(∀x)R это буквально ¬¬(∃x)¬R.
theorem C28 {R : rel 1} : ¬(∀x)R(x) ⇔ (∃x)¬R(x) by C24_1

-- C29 (стр. 55), по плану книги: из R ⇔ ¬¬R подстановкой C3 и схемой S5.
theorem C29 {R : rel 1} : ¬(∃x)R(x) ⇔ (∀x)¬R(x) {
  R(x) ⇒ ¬¬R(x)                         by C11
  (∃x)R(x) ⇒ ¬¬R(τx(R(x)))              by subst ^ with x := τx(R(x))
  ¬¬R(τx(R(x))) ⇒ (∃x)¬¬R(x)            by S5 with R(x) := ¬¬R(x)
  (∃x)R(x) ⇒ (∃x)¬¬R(x)                 by C6 2 3
  ¬¬R(x) ⇒ R(x)                         by C16
  (∃x)¬¬R(x) ⇒ R(τx(¬¬R(x)))            by subst ^ with x := τx(¬¬R(x))
  R(τx(¬¬R(x))) ⇒ (∃x)R(x)              by S5
  (∃x)¬¬R(x) ⇒ (∃x)R(x)                 by C6 6 7
  (∃x)R(x) ⇔ (∃x)¬¬R(x)                 by C20 4 8
  ¬(∃x)R(x) ⇔ (∀x)¬R(x)                 by C23a ^
}

-- C30 доказана в 02_quant_eq.bk.

-- C30 для двух кванторов сразу (удобно для аксиом вида (∀x)(∀y)...).
theorem C30_2 {R : rel 2} {T U : term} : (∀x)(∀y)R(x, y) ⇒ R(T, U) {
  (∀x)(∀y)R(x, y) ⇒ (∀y)R(T, y)   by C30 with R(t) := (∀y)R(t, y); T := T
  (∀y)R(T, y) ⇒ R(T, U)           by C30 with R(t) := R(T, t); T := U
  _                               by C6 1 2
}

-- C30 вместе с силлогизмом: из (∀x)R получить R(T) одной строкой.
theorem inst {R : rel 1} {T : term} (h : (∀x)R(x)) : R(T) {
  (∀x)R(x) ⇒ R(T)   by C30
  _                 by mp h ^
}

theorem inst2 {R : rel 2} {T U : term} (h : (∀x)(∀y)R(x, y)) : R(T, U) {
  (∀x)(∀y)R(x, y) ⇒ R(T, U)   by C30_2
  _                           by mp h ^
}

-- C19, метод вспомогательной константы (§ 3, n° 3, стр. 48-49).
-- Это не новое правило языка, а теорема: новые "правила" пишутся теоремами с гипотезами.
-- "Пусть x такой предмет, что A(x)" записывается блоком assume, затем обобщением по x;
-- условие "x не константа" проверяет gen, а условие "x не встречается в B" выполнено
-- само: B метапеременная веса 0, в неё никакая буква не входит.
--   A(x) ⇒ B           by assume h { ... }    -- внутри блока x вспомогательная константа
--   (∀x)(A(x) ⇒ B)     by gen ^ with x
--   B                  by C19 t ^              -- t: строка A(T), "теорема узаконения"
theorem C19 {A : rel 1} {B : rel} {T : term} (h : A(T)) (hb : (∀x)(A(x) ⇒ B)) : B {
  (∀x)(A(x) ⇒ B) ⇒ (A(T) ⇒ B)   by C30 with R(t) := A(t) ⇒ B; T := T
  A(T) ⇒ B                      by mp hb ^
  B                             by mp h ^
}

-- C19, когда известно только (∃x)A(x): это буквально A(τx(A(x))), так что T := τx(A(x)).
theorem obtain {A : rel 1} {B : rel} (h : (∃x)A(x)) (hb : (∀x)(A(x) ⇒ B)) : B by C19 h hb

-- obtain для двух букв сразу: (∃x)(∃y)A(x, y).
theorem obtain2 {A : rel 2} {B : rel} (h : (∃x)(∃y)A(x, y)) (hb : (∀x)(∀y)(A(x, y) ⇒ B)) : B {
  (∃y)A(x, y) ⇒ B by assume e {
    (∀y)(A(x, y) ⇒ B)        by inst hb
    B                        by obtain e ^
  }
  (∀x)((∃y)A(x, y) ⇒ B)      by gen ^ with x
  B                          by obtain h ^
}

-- C31 (∀, стр. 56). План книги: присоединим (∀x)R; тогда R, значит S, значит (∀x)S.
theorem C31 {R S : rel 1} (h : (∀x)(R(x) ⇒ S(x))) : (∀x)R(x) ⇒ (∀x)S(x) {
  (∀x)R(x) ⇒ (∀x)S(x) by assume a {
    (∀x)R(x) ⇒ R(x)                      by C30
    R(x)                                 by mp a ^
    (∀x)(R(x) ⇒ S(x)) ⇒ (R(x) ⇒ S(x))    by C30
    R(x) ⇒ S(x)                          by mp h ^
    S(x)                                 by mp 2 4
    (∀x)S(x)                             by gen ^ with x
  }
}

-- C31 (∃). Книга выводит из C29; короче подстановкой: R(x) ⇒ (∃x)S, и x := τx(R(x)).
theorem C31_exists {R S : rel 1} (h : (∀x)(R(x) ⇒ S(x))) : (∃x)R(x) ⇒ (∃x)S(x) {
  (∀x)(R(x) ⇒ S(x)) ⇒ (R(x) ⇒ S(x))   by C30
  R(x) ⇒ S(x)                          by mp h ^
  S(x) ⇒ (∃x)S(x)                      by S5
  R(x) ⇒ (∃x)S(x)                      by C6 2 3
  (∃x)R(x) ⇒ (∃x)S(x)                  by subst ^ with x := τx(R(x))
}

-- C31 для ⇔.
theorem C31_iff {R S : rel 1} (h : (∀x)(R(x) ⇔ S(x))) : (∀x)R(x) ⇔ (∀x)S(x) {
  (∀x)(R(x) ⇔ S(x)) ⇒ (R(x) ⇔ S(x))   by C30
  rs. R(x) ⇔ S(x)                      by mp h ^
  R(x) ⇒ S(x)                          by iff_imp rs
  (∀x)(R(x) ⇒ S(x))                    by gen ^ with x
  S(x) ⇒ R(x)                          by iff_imp' rs
  (∀x)(S(x) ⇒ R(x))                    by gen ^ with x
  (∀x)R(x) ⇒ (∀x)S(x)                  by C31 4
  (∀x)S(x) ⇒ (∀x)R(x)                  by C31 6
  _                                    by C20 7 8
}

theorem C31_exists_iff {R S : rel 1} (h : (∀x)(R(x) ⇔ S(x))) : (∃x)R(x) ⇔ (∃x)S(x) {
  (∀x)(R(x) ⇔ S(x)) ⇒ (R(x) ⇔ S(x))   by C30
  rs. R(x) ⇔ S(x)                      by mp h ^
  R(x) ⇒ S(x)                          by iff_imp rs
  (∀x)(R(x) ⇒ S(x))                    by gen ^ with x
  S(x) ⇒ R(x)                          by iff_imp' rs
  (∀x)(S(x) ⇒ R(x))                    by gen ^ with x
  (∃x)R(x) ⇒ (∃x)S(x)                  by C31_exists 4
  (∃x)S(x) ⇒ (∃x)R(x)                  by C31_exists 6
  _                                    by C20 7 8
}

-- C32 (∀ и ∧, стр. 56), по плану книги: в обе стороны через вспомогательную гипотезу.
theorem C32 {R S : rel 1} : (∀x)(R(x) ∧ S(x)) ⇔ ((∀x)R(x) ∧ (∀x)S(x)) {
  (∀x)(R(x) ∧ S(x)) ⇒ ((∀x)R(x) ∧ (∀x)S(x)) by assume h {
    (∀x)(R(x) ∧ S(x)) ⇒ (R(x) ∧ S(x))   by C30
    rs. R(x) ∧ S(x)                      by mp h ^
    (R(x) ∧ S(x)) ⇒ R(x)                 by C21
    R(x)                                 by mp rs ^
    r. (∀x)R(x)                          by gen ^ with x
    (R(x) ∧ S(x)) ⇒ S(x)                 by C21'
    S(x)                                 by mp rs ^
    (∀x)S(x)                             by gen ^ with x
    (∀x)R(x) ∧ (∀x)S(x)                  by C20 r ^
  }
  ((∀x)R(x) ∧ (∀x)S(x)) ⇒ (∀x)(R(x) ∧ S(x)) by assume h {
    ((∀x)R(x) ∧ (∀x)S(x)) ⇒ (∀x)R(x)    by C21
    (∀x)R(x)                             by mp h ^
    (∀x)R(x) ⇒ R(x)                      by C30
    r. R(x)                              by mp 2 3
    ((∀x)R(x) ∧ (∀x)S(x)) ⇒ (∀x)S(x)    by C21'
    (∀x)S(x)                             by mp h ^
    (∀x)S(x) ⇒ S(x)                      by C30
    S(x)                                 by mp 6 7
    R(x) ∧ S(x)                          by C20 r ^
    (∀x)(R(x) ∧ S(x))                    by gen ^ with x
  }
  _ by C20 1 2
}

-- C32 (∃ и ∨): в одну сторону подстановкой τ, в другую по C31.
theorem C32' {R S : rel 1} : (∃x)(R(x) ∨ S(x)) ⇔ ((∃x)R(x) ∨ (∃x)S(x)) {
  R(x) ⇒ (∃x)R(x)                                     by S5
  (∃x)R(x) ⇒ ((∃x)R(x) ∨ (∃x)S(x))                    by S2
  R(x) ⇒ ((∃x)R(x) ∨ (∃x)S(x))                        by C6 1 2
  S(x) ⇒ (∃x)S(x)                                     by S5
  (∃x)S(x) ⇒ ((∃x)R(x) ∨ (∃x)S(x))                    by C7
  S(x) ⇒ ((∃x)R(x) ∨ (∃x)S(x))                        by C6 4 5
  (R(x) ∨ S(x)) ⇒ ((∃x)R(x) ∨ (∃x)S(x))               by cases_imp 3 6
  (∃x)(R(x) ∨ S(x)) ⇒ ((∃x)R(x) ∨ (∃x)S(x))           by subst ^ with x := τx(R(x) ∨ S(x))
  R(x) ⇒ (R(x) ∨ S(x))                                by S2
  (∀x)(R(x) ⇒ (R(x) ∨ S(x)))                          by gen ^ with x
  (∃x)R(x) ⇒ (∃x)(R(x) ∨ S(x))                        by C31_exists ^
  S(x) ⇒ (R(x) ∨ S(x))                                by C7
  (∀x)(S(x) ⇒ (R(x) ∨ S(x)))                          by gen ^ with x
  (∃x)S(x) ⇒ (∃x)(R(x) ∨ S(x))                        by C31_exists ^
  ((∃x)R(x) ∨ (∃x)S(x)) ⇒ (∃x)(R(x) ∨ S(x))           by cases_imp 11 14
  _                                                   by C20 8 15
}

-- C33 (∃ и ∧), x не встречается в R: R это метапеременная веса 0.
theorem C33' {R : rel} {S : rel 1} : (∃x)(R ∧ S(x)) ⇔ (R ∧ (∃x)S(x)) {
  (R ∧ S(x)) ⇒ R                          by C21
  (R ∧ S(x)) ⇒ S(x)                       by C21'
  S(x) ⇒ (∃x)S(x)                         by S5
  (R ∧ S(x)) ⇒ (∃x)S(x)                   by C6 2 3
  (R ∧ S(x)) ⇒ (R ∧ (∃x)S(x))             by imp_and 1 4
  (∃x)(R ∧ S(x)) ⇒ (R ∧ (∃x)S(x))         by subst ^ with x := τx(R ∧ S(x))
  -- обратно: пусть R и (∃x)S(x); возьмём x такой, что S(x) (C19)
  (R ∧ (∃x)S(x)) ⇒ (∃x)(R ∧ S(x)) by assume h {
    (R ∧ (∃x)S(x)) ⇒ R                    by C21
    r. R                                  by mp h ^
    (R ∧ (∃x)S(x)) ⇒ (∃x)S(x)             by C21'
    e. (∃x)S(x)                           by mp h ^
    S(x) ⇒ (∃x)(R ∧ S(x)) by assume s {
      R ∧ S(x)                            by C20 r s
      (R ∧ S(x)) ⇒ (∃x)(R ∧ S(x))         by S5
      (∃x)(R ∧ S(x))                      by mp 1 2
    }
    (∀x)(S(x) ⇒ (∃x)(R ∧ S(x)))           by gen ^ with x
    (∃x)(R ∧ S(x))                        by obtain e ^
  }
  _                                       by C20 6 7
}

-- C33 (∀ и ∨): двойственно, через ¬ и C33'.
theorem C33 {R : rel} {S : rel 1} : (∀x)(R ∨ S(x)) ⇔ (R ∨ (∀x)S(x)) {
  ¬(R ∨ S(x)) ⇔ (¬R ∧ ¬S(x))                      by taut
  (∀x)(¬(R ∨ S(x)) ⇔ (¬R ∧ ¬S(x)))                by gen ^ with x
  (∃x)¬(R ∨ S(x)) ⇔ (∃x)(¬R ∧ ¬S(x))              by C31_exists_iff ^
  (∃x)(¬R ∧ ¬S(x)) ⇔ (¬R ∧ (∃x)¬S(x))             by C33' with R := ¬R; S(x) := ¬S(x)
  (∃x)¬(R ∨ S(x)) ⇔ (¬R ∧ (∃x)¬S(x))              by C22' 3 4
  ¬(∃x)¬(R ∨ S(x)) ⇔ ¬(¬R ∧ (∃x)¬S(x))            by C23a ^
  ¬(¬R ∧ (∃x)¬S(x)) ⇔ (R ∨ (∀x)S(x))              by taut
  _                                               by C22' 6 7
}

-- C34. R{x, y} это метапеременная веса 2.
theorem C34 {R : rel 2} : (∀x)(∀y)R(x, y) ⇔ (∀y)(∀x)R(x, y) {
  (∀x)(∀y)R(x, y) ⇒ (∀y)(∀x)R(x, y) by assume h {
    (∀x)(∀y)R(x, y) ⇒ (∀y)R(x, y)       by C30 with R(t) := (∀y)R(t, y); T := x
    (∀y)R(x, y)                         by mp h ^
    (∀y)R(x, y) ⇒ R(x, y)               by C30 with R(t) := R(x, t); T := y
    R(x, y)                             by mp 2 3
    (∀x)R(x, y)                         by gen ^ with x
    (∀y)(∀x)R(x, y)                     by gen ^ with y
  }
  (∀y)(∀x)R(x, y) ⇒ (∀x)(∀y)R(x, y) by assume h {
    (∀y)(∀x)R(x, y) ⇒ (∀x)R(x, y)       by C30 with R(t) := (∀x)R(x, t); T := y
    (∀x)R(x, y)                         by mp h ^
    (∀x)R(x, y) ⇒ R(x, y)               by C30 with R(t) := R(t, y); T := x
    R(x, y)                             by mp 2 3
    (∀y)R(x, y)                         by gen ^ with y
    (∀x)(∀y)R(x, y)                     by gen ^ with x
  }
  _ by C20 1 2
}

theorem C34' {R : rel 2} : (∃x)(∃y)R(x, y) ⇔ (∃y)(∃x)R(x, y) {
  R(x, y) ⇒ (∃x)R(x, y)                       by S5 with R(t) := R(t, y); T := x
  (∃x)R(x, y) ⇒ (∃y)(∃x)R(x, y)               by S5 with R(t) := (∃x)R(x, t); T := y
  R(x, y) ⇒ (∃y)(∃x)R(x, y)                   by C6 1 2
  (∃y)R(x, y) ⇒ (∃y)(∃x)R(x, y)               by subst ^ with y := τy(R(x, y))
  (∃x)(∃y)R(x, y) ⇒ (∃y)(∃x)R(x, y)           by subst ^ with x := τx((∃y)R(x, y))
  R(x, y) ⇒ (∃y)R(x, y)                       by S5 with R(t) := R(x, t); T := y
  (∃y)R(x, y) ⇒ (∃x)(∃y)R(x, y)               by S5 with R(t) := (∃y)R(t, y); T := x
  R(x, y) ⇒ (∃x)(∃y)R(x, y)                   by C6 6 7
  (∃x)R(x, y) ⇒ (∃x)(∃y)R(x, y)               by subst ^ with x := τx(R(x, y))
  (∃y)(∃x)R(x, y) ⇒ (∃x)(∃y)R(x, y)           by subst ^ with y := τy((∃x)R(x, y))
  _                                           by C20 5 10
}

-- Обратное неверно: из (∀y)(∃x)R не следует (∃x)(∀y)R (см. замечание после C34, стр. 57).
-- Как в книге: пусть (∃x)(∀y)R; возьмём такой x (C19); тогда для всякого y R(x, y),
-- значит (∃x)R(x, y), и это верно для всякого y.
theorem C34'' {R : rel 2} : (∃x)(∀y)R(x, y) ⇒ (∀y)(∃x)R(x, y) {
  (∃x)(∀y)R(x, y) ⇒ (∀y)(∃x)R(x, y) by assume h {
    (∀y)R(x, y) ⇒ (∀y)(∃x)R(x, y) by assume a {
      (∀y)R(x, y) ⇒ R(x, y)                   by C30 with R(t) := R(x, t); T := y
      R(x, y)                                 by mp a ^
      R(x, y) ⇒ (∃x)R(x, y)                   by S5 with R(t) := R(t, y); T := x
      (∃x)R(x, y)                             by mp 2 3
      (∀y)(∃x)R(x, y)                         by gen ^ with y
    }
    (∀x)((∀y)R(x, y) ⇒ (∀y)(∃x)R(x, y))       by gen ^ with x
    (∀y)(∃x)R(x, y)                           by obtain h ^
  }
}

-- C33' с членом справа: (∃x)(S ∧ R) ⇔ ((∃x)S ∧ R), x не встречается в R.
theorem exists_and_right {R : rel} {S : rel 1} : (∃x)(S(x) ∧ R) ⇔ ((∃x)S(x) ∧ R) {
  (S(x) ∧ R) ⇔ (R ∧ S(x))                       by C24_4
  (∀x)((S(x) ∧ R) ⇔ (R ∧ S(x)))                 by gen ^ with x
  a. (∃x)(S(x) ∧ R) ⇔ (∃x)(R ∧ S(x))            by C31_exists_iff ^
  b. (∃x)(R ∧ S(x)) ⇔ (R ∧ (∃x)S(x))            by C33'
  _                                             by taut a b
}

-- Перестановка кванторов в "композиции": (∃x)(A ∧ (∃y)(B ∧ C)) ⇔ (∃y)((∃x)(A ∧ B) ∧ C).
-- Обе части эквивалентны (∃x)(∃y)(A ∧ (B ∧ C)) по C33' и C34'.
theorem ex_assoc {A C : rel 1} {B : rel 2} : (∃x)(A(x) ∧ (∃y)(B(x, y) ∧ C(y))) ⇔ (∃y)((∃x)(A(x) ∧ B(x, y)) ∧ C(y)) {
  (∃y)(A(x) ∧ (B(x, y) ∧ C(y))) ⇔ (A(x) ∧ (∃y)(B(x, y) ∧ C(y)))       by C33'
  (A(x) ∧ (∃y)(B(x, y) ∧ C(y))) ⇔ (∃y)(A(x) ∧ (B(x, y) ∧ C(y)))       by C22 ^
  (∀x)((A(x) ∧ (∃y)(B(x, y) ∧ C(y))) ⇔ (∃y)(A(x) ∧ (B(x, y) ∧ C(y))))   by gen ^ with x
  l. (∃x)(A(x) ∧ (∃y)(B(x, y) ∧ C(y))) ⇔ (∃x)(∃y)(A(x) ∧ (B(x, y) ∧ C(y)))   by C31_exists_iff ^
  a. (∃x)((A(x) ∧ B(x, y)) ∧ C(y)) ⇔ ((∃x)(A(x) ∧ B(x, y)) ∧ C(y))    by exists_and_right
  ((A(x) ∧ B(x, y)) ∧ C(y)) ⇔ (A(x) ∧ (B(x, y) ∧ C(y)))               by taut
  (∀x)(((A(x) ∧ B(x, y)) ∧ C(y)) ⇔ (A(x) ∧ (B(x, y) ∧ C(y))))         by gen ^ with x
  b. (∃x)((A(x) ∧ B(x, y)) ∧ C(y)) ⇔ (∃x)(A(x) ∧ (B(x, y) ∧ C(y)))    by C31_exists_iff ^
  ((∃x)(A(x) ∧ B(x, y)) ∧ C(y)) ⇔ (∃x)(A(x) ∧ (B(x, y) ∧ C(y)))       by taut a b
  (∀y)(((∃x)(A(x) ∧ B(x, y)) ∧ C(y)) ⇔ (∃x)(A(x) ∧ (B(x, y) ∧ C(y))))   by gen ^ with y
  r. (∃y)((∃x)(A(x) ∧ B(x, y)) ∧ C(y)) ⇔ (∃y)(∃x)(A(x) ∧ (B(x, y) ∧ C(y)))   by C31_exists_iff ^
  s. (∃x)(∃y)(A(x) ∧ (B(x, y) ∧ C(y))) ⇔ (∃y)(∃x)(A(x) ∧ (B(x, y) ∧ C(y)))   by C34'
  _                                                                     by taut l r s
}

-- То же без A: (∃x)(∃y)(B ∧ C) ⇔ (∃y)((∃x)B ∧ C).
theorem ex_assoc' {C : rel 1} {B : rel 2} : (∃x)(∃y)(B(x, y) ∧ C(y)) ⇔ (∃y)((∃x)B(x, y) ∧ C(y)) {
  (∃x)(B(x, y) ∧ C(y)) ⇔ ((∃x)B(x, y) ∧ C(y))                        by exists_and_right
  ((∃x)B(x, y) ∧ C(y)) ⇔ (∃x)(B(x, y) ∧ C(y))                        by C22 ^
  (∀y)(((∃x)B(x, y) ∧ C(y)) ⇔ (∃x)(B(x, y) ∧ C(y)))                  by gen ^ with y
  r. (∃y)((∃x)B(x, y) ∧ C(y)) ⇔ (∃y)(∃x)(B(x, y) ∧ C(y))             by C31_exists_iff ^
  s. (∃x)(∃y)(B(x, y) ∧ C(y)) ⇔ (∃y)(∃x)(B(x, y) ∧ C(y))             by C34'
  _                                                                   by taut r s
}


-- Двойственное к ex_assoc: (∀y)((∃x)(A ∧ B) ⇒ C) ⇔ (∀x)(A ⇒ (∀y)(B ⇒ C)).
theorem all_assoc {A C : rel 1} {B : rel 2} : (∀y)((∃x)(A(x) ∧ B(x, y)) ⇒ C(y)) ⇔ (∀x)(A(x) ⇒ (∀y)(B(x, y) ⇒ C(y))) {
  (∀y)((∃x)(A(x) ∧ B(x, y)) ⇒ C(y)) ⇒ (∀x)(A(x) ⇒ (∀y)(B(x, y) ⇒ C(y))) by assume h {
    A(x) ⇒ (∀y)(B(x, y) ⇒ C(y)) by assume a {
      B(x, y) ⇒ C(y) by assume b {
        A(x) ∧ B(x, y)                           by C20 a b
        (∃x)(A(x) ∧ B(x, y))                     by exists_intro ^
        (∃x)(A(x) ∧ B(x, y)) ⇒ C(y)              by inst h
        C(y)                                     by mp 2 3
      }
      (∀y)(B(x, y) ⇒ C(y))                       by gen ^ with y
    }
    (∀x)(A(x) ⇒ (∀y)(B(x, y) ⇒ C(y)))            by gen ^ with x
  }
  (∀x)(A(x) ⇒ (∀y)(B(x, y) ⇒ C(y))) ⇒ (∀y)((∃x)(A(x) ∧ B(x, y)) ⇒ C(y)) by assume h {
    (∃x)(A(x) ∧ B(x, y)) ⇒ C(y) by assume e {
      (A(x) ∧ B(x, y)) ⇒ C(y) by assume a {
        A(x) ⇒ (∀y)(B(x, y) ⇒ C(y))              by inst h
        (∀y)(B(x, y) ⇒ C(y))                     by taut a ^
        B(x, y) ⇒ C(y)                           by inst ^
        C(y)                                     by taut a ^
      }
      (∀x)((A(x) ∧ B(x, y)) ⇒ C(y))              by gen ^ with x
      C(y)                                       by obtain e ^
    }
    (∀y)((∃x)(A(x) ∧ B(x, y)) ⇒ C(y))            by gen ^ with y
  }
  _                                              by iff_intro 1 2
}


-- Если (∃x)A, то (∀x)(A ⇒ P) ⇔ P (x не встречается в P).
theorem forall_imp_const {A : rel 1} {P : rel} (h : (∃x)A(x)) : (∀x)(A(x) ⇒ P) ⇔ P {
  (∀x)(A(x) ⇒ P) ⇒ P by assume a {
    P                                            by obtain h a
  }
  P ⇒ (∀x)(A(x) ⇒ P) by assume p {
    A(x) ⇒ P                                     by taut p
    (∀x)(A(x) ⇒ P)                               by gen ^ with x
  }
  _                                              by iff_intro 1 2
}

-- Если (∃x)A, то (∀x)(A ⇒ (P ∧ Q)) ⇔ (P ∧ (∀x)(A ⇒ Q)).
theorem forall_and_const {A Q : rel 1} {P : rel} (h : (∃x)A(x)) : (∀x)(A(x) ⇒ (P ∧ Q(x))) ⇔ (P ∧ (∀x)(A(x) ⇒ Q(x))) {
  (A(x) ⇒ (P ∧ Q(x))) ⇔ ((A(x) ⇒ P) ∧ (A(x) ⇒ Q(x)))                         by taut
  (∀x)((A(x) ⇒ (P ∧ Q(x))) ⇔ ((A(x) ⇒ P) ∧ (A(x) ⇒ Q(x))))                   by gen ^ with x
  a. (∀x)(A(x) ⇒ (P ∧ Q(x))) ⇔ (∀x)((A(x) ⇒ P) ∧ (A(x) ⇒ Q(x)))              by C31_iff ^
  b. (∀x)((A(x) ⇒ P) ∧ (A(x) ⇒ Q(x))) ⇔ ((∀x)(A(x) ⇒ P) ∧ (∀x)(A(x) ⇒ Q(x)))   by C32
  c. (∀x)(A(x) ⇒ P) ⇔ P                                                      by forall_imp_const h
  _                                                                          by taut a b c
}

end
