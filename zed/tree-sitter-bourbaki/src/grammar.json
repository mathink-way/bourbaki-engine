{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "bourbaki",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_token"
      }
    },
    "_token": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "rule"
        },
        {
          "type": "SYMBOL",
          "name": "command"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "punctuation"
        },
        {
          "type": "SYMBOL",
          "name": "other"
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "--"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "keyword": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "import"
        },
        {
          "type": "STRING",
          "value": "namespace"
        },
        {
          "type": "STRING",
          "value": "end"
        },
        {
          "type": "STRING",
          "value": "open"
        },
        {
          "type": "STRING",
          "value": "alias"
        },
        {
          "type": "STRING",
          "value": "sign"
        },
        {
          "type": "STRING",
          "value": "abbrev"
        },
        {
          "type": "STRING",
          "value": "scheme"
        },
        {
          "type": "STRING",
          "value": "theory"
        },
        {
          "type": "STRING",
          "value": "extends"
        },
        {
          "type": "STRING",
          "value": "in"
        },
        {
          "type": "STRING",
          "value": "theorem"
        },
        {
          "type": "STRING",
          "value": "lemma"
        },
        {
          "type": "STRING",
          "value": "by"
        },
        {
          "type": "STRING",
          "value": "with"
        },
        {
          "type": "STRING",
          "value": "model"
        },
        {
          "type": "STRING",
          "value": "transfer"
        },
        {
          "type": "STRING",
          "value": "via"
        },
        {
          "type": "STRING",
          "value": "as"
        },
        {
          "type": "STRING",
          "value": "signs"
        },
        {
          "type": "STRING",
          "value": "schemes"
        },
        {
          "type": "STRING",
          "value": "axiom"
        },
        {
          "type": "STRING",
          "value": "rel"
        },
        {
          "type": "STRING",
          "value": "term"
        },
        {
          "type": "STRING",
          "value": "infix"
        }
      ]
    },
    "rule": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "mp"
        },
        {
          "type": "STRING",
          "value": "gen"
        },
        {
          "type": "STRING",
          "value": "subst"
        },
        {
          "type": "STRING",
          "value": "taut"
        },
        {
          "type": "STRING",
          "value": "assume"
        },
        {
          "type": "STRING",
          "value": "contra"
        },
        {
          "type": "STRING",
          "value": "sorry"
        }
      ]
    },
    "command": {
      "type": "PATTERN",
      "value": "#[a-z]+"
    },
    "string": {
      "type": "PATTERN",
      "value": "\"[^\"\\n]*\""
    },
    "number": {
      "type": "PATTERN",
      "value": "[0-9]+"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[\\p{L}_][\\p{L}\\p{N}_'.]*"
    },
    "operator": {
      "type": "PATTERN",
      "value": "[¬∨∧⇒⇔∃∀τ=∈∉⊂≠→↔~<>^|:]+"
    },
    "punctuation": {
      "type": "PATTERN",
      "value": "[(){}\\[\\],;.]"
    },
    "other": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\s]"
        }
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}